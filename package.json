{
  "name": "superhero-powers-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "docs:powers": "node scripts/generate-power-taxonomy-doc.mjs",
    "enrich:powers": "node scripts/enrich-power-rankings.mjs",
    "audit:powers": "node scripts/audit-power-assets.mjs",
    "refresh:powers": "npm run import:superpowers && npm run enrich:powers && npm run docs:powers",
    "import:superpowers": "node scripts/import-superpower-list.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:watch": "vitest src",
    "lint": "eslint .",
    "verify": "npm run audit:powers && npm run test && npm run test:e2e && npm run lint && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "csv-parse": "^6.1.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "vitest": "^3.2.4"
  }
}
