{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "scripts/*.mjs",
    "src/utils/dataSourceModel.js",
    "src/utils/heroBuilder.js",
    "src/utils/importedPowerPool.js",
    "src/utils/logger.js",
    "src/utils/powerLibrary.js",
    "src/utils/powerModel.js",
    "src/utils/rankingModel.js",
    "src/utils/runtimeGuards.js"
  ]
}
